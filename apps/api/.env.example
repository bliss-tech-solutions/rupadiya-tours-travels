# ==============================================================================
# RUPADIYA BUS BOOKING PLATFORM — API PRODUCTION CONFIGURATION (.env.example)
# ==============================================================================

# 1. SERVER ENVIRONMENT
NODE_ENV=production
PORT=4500

# 2. DATABASE CONFIGURATION (MongoDB Atlas or Self-Hosted)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rupadiya?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/rupadiya?retryWrites=true&w=majority
MONGODB_DB=rupadiya

# 3. DISTRIBUTED CACHE & CONCURRENCY LOCKS (Upstash Redis or Self-Hosted)
# Example: rediss://default:your_password@your-redis-endpoint.upstash.io:6379
REDIS_URL=rediss://default:your_password@your-redis-endpoint.upstash.io:6379

# 4. CORS & ORIGIN SECURITY ALLOWLIST (Comma-separated list of deployed domains)
# Specify all live frontend application URLs (include protocol https://, NO trailing slashes)
ALLOWED_ORIGINS=https://rupadiya.com,https://admin.rupadiya.com,https://company.rupadiya.com,https://agent.rupadiya.com,https://your-app.vercel.app
WEB_ORIGIN=https://rupadiya.com

# 5. COLD-START PREVENTER & SELF-HEALTH CHECK
# The public or internal URL where the API is hosted (for automated 9-min keep-alive ping)
SELF_URL=https://api.rupadiya.com

# 6. COOKIE SETTINGS FOR CROSS-DOMAIN / SUBDOMAIN AUTH
# Option A: If all portals share top-level domain (e.g. *.rupadiya.com):
# COOKIE_DOMAIN=.rupadiya.com
# COOKIE_SAME_SITE=lax
#
# Option B: If API is on a different host (e.g. Render/Railway) and frontends are on Vercel:
# Leave COOKIE_DOMAIN unset, set COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.rupadiya.com
COOKIE_SAME_SITE=lax

# 7. JWT SECRETS (Generate strong 64-char random hex strings: `openssl rand -hex 32`)
AUTH_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
AUTH_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
COOKIE_SECRET=your_super_secret_signed_cookie_key_at_least_32_characters_long
SESSION_SECRET=your_super_secret_session_signing_key_at_least_32_characters_long

AUTH_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=24h

# 8. PAYMENT GATEWAY (Razorpay Live / Test Credentials)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# 9. AWS S3 STORAGE (Documents & Bus Photos)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-production-s3-bucket
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_PRESIGN_EXPIRES=900

# 10. SYSTEM RULES & TAXATION
HOLD_DURATION_SECONDS=600
TCS_RATE=0.01
GST_RATE=0.05

