{
  "expo": {
    "name": "Rupadiya Manager",
    "slug": "rupadiya-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.rupadiya.manager",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.rupadiya.manager",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan passenger ticket QR codes while boarding."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan passenger ticket QR codes while boarding.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://rupadiya-tours-travels.onrender.com/api/v1",
      "eas": {
        "projectId": "519fe9fa-7124-4eac-ac07-97894741d6d4"
      }
    },
    "owner": "harsh2414"
  }
}
