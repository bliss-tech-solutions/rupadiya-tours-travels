{
  "expo": {
    "name": "Rupadiya Manager",
    "slug": "rupadiya-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.rupadiya.manager",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1456C8"
      }
    },
    "ios": {
      "bundleIdentifier": "in.rupadiya.manager",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan passenger ticket QR codes while boarding."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan passenger ticket QR codes while boarding.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F4B"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://rupadiya-tours-travels-1.onrender.com/api/v1",
      "eas": {
        "projectId": "519fe9fa-7124-4eac-ac07-97894741d6d4"
      }
    },
    "owner": "harsh2414",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/519fe9fa-7124-4eac-ac07-97894741d6d4",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png"
  }
}
